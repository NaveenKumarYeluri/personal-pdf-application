{
  "name": "personal-pdf-suite",
  "version": "1.0.0",
  "description": "Cross-platform personal PDF application with Adobe Acrobat-level functionality",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "python serve.py",
    "build:windows": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage",
    "build:android": "cap build android",
    "cap:sync": "cap sync android"
  },
  "keywords": [
    "pdf",
    "acrobat",
    "editor",
    "annotations",
    "signatures",
    "cross-platform"
  ],
  "author": "Personal",
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.personal.pdfsuite",
    "productName": "Personal PDF Suite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icons/app-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "src/assets/icons/app-icon.png"
    }
  }
}
